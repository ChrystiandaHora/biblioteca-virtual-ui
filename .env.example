# Copie para `.env` (ou `.env.local`) e ajuste conforme o seu ambiente.
# Somente variáveis com o prefixo VITE_ chegam ao código do navegador.

# Endereço da Biblioteca Virtual API.
# Deve apontar para a URL que o NAVEGADOR usa — não para o nome do serviço no
# Docker, já que a requisição sai da máquina de quem acessa.
VITE_API_URL=http://localhost:8000
